# Set these values in the backend process environment for local development.
# This example is documentation only and is not loaded automatically.
DATABASE_URL=
REVIEWER_DEMO_SECRET=

# Optional persistent agent runtime. Credentials are backend-only.
# Migration 004 must be applied explicitly before enabling; use one API worker.
AGENT_HARNESS_ENABLED=0
OPENAI_API_KEY=
AGENT_MODEL=
# Trusted Python factory returning (DiscoveryGateway, ReportingGateway).
# Leave empty until the teammate-owned implementations are connected.
AGENT_SERVICE_FACTORY=
AGENT_MAX_DECISIONS=12
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_REPLANS=2
AGENT_TIMEOUT_SECONDS=120
